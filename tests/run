#!/usr/bin/env bash
#
# run.sh
#
# Tests traffic blocking/restriction for all fw-censor modes.
#
# Exit status:
#   0 = traffic is flowing normally
#   1 = traffic is restricted (blocked, dropped, timed out, or otherwise unavailable)
#
# Results:
#   ./test/results/traffic_tests.csv

set -u

source "./config.sh"
source "./lib.sh"
source "./import_lists.sh"

source "./dns_test.sh"
source "./ip_block.sh"
source "./dot_block.sh"
source "./doq_block.sh"
source "./doh_block.sh"
source "./quic_block.sh"

import_lists

run_all () {
    run_ip_block
    log "run_ip_block -> done"
    run_dns_interception
    log "run_dns_interception -> done"
    run_dns_bypass
    log "run_dns_bypass -> done"
    run_doh_block
    log "run_doh -> done"
    run_dot_block
    log "run_dot_block -> done"
    run_doq_block
    log "run_doq_block -> done"
    run_quic_block
    log "run_quic_block -> done"
}

run_mode() {
    local mode="$1"

    CURRENT_MODE="$mode"

    echo
    echo "========================================"
    echo " Testing mode: $mode"
    echo "========================================"

    read -rp "Set fw-censor to '$mode', then press Enter..."

    run_all

    echo "Finished: $mode"
}

echo "test_type,stack,server,domain,ms,blocked" > $OUTFILE
run_mode base
# run_mode td
# run_mode tc

aggregate_results

log "Done. Results written to $OUTFILE"