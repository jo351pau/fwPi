#!/bin/bash

# /usr/local/bin/fwPiCLI/fw-censor
# Censorship testbed CLI
# Modes: td (traffic drop) | tc (traffic control) | base (passthrough)
#
# Usage:
#   fw-censor td            — full IP/protocol blocking
#   fw-censor tc          — rate-limit censored traffic
#   fw-censor tc 64kbit   — throttle at custom rate
#   fw-censor base           — passthrough, no filtering
#   fw-censor status            — current mode + counters
#   fw-censor reload            — reload blocklists from disk

set -euo pipefail

LIB_DIR="/usr/local/lib/fwPi/fwPiCLI"

source "$LIB_DIR/config"
source "$LIB_DIR/lib"


# -----------------------------------------------------------
# commands
# -----------------------------------------------------------
cmd_td() {
  teardown_all
  load_mode td
  insert_jump td
  set_mode td
  echo "td mode active"
}

cmd_tc() {
  local rate="${1:-$TC_RATE}"

  teardown_all
  load_mode tc
  insert_jump tc
  tc_setup "$rate"
  set_mode tc
  echo "tc mode active"
}

cmd_base() {
  teardown_all
  nft -f "$NFT_BASE"
  set_mode "base"
  echo "Base fw active."
}

cmd_status() {
    local mode
    mode=$(current_mode)

    echo ""
    echo "==============================="
    echo " fw-censor status"
    echo "==============================="
    echo " Mode: $mode"
    echo ""

    echo "--- nftables forward chain ---"
    nft list chain "$TABLE" "$CHAIN_FWD" 2>/dev/null || echo "(not loaded)"

    echo ""
    echo "--- traffic_drop chain counters ---"
    nft list chain "$TABLE" "$CHAIN_TD" 2>/dev/null || echo "(not active)"

    if [[ "$mode" == "tc" ]]; then
      echo ""
      echo "--- traffic_control chain ---"
      nft list chain $TABLE "$CHAIN_TC" 2>/dev/null || echo "(not active)"

      echo ""
      echo "--- traffic_control classes (bytes/packets) ---"
      tc -s class show dev "$IFACE" 2>/dev/null || echo "(not active)"
    fi
}

# reload always uses default rate for tc
cmd_reload() {
    local mode
    mode=$(current_mode)

    echo "Reloading $mode configuration..."

    case "$mode" in
      td|tc)
          teardown_all
          nft -f "$NFT_BASE"
          load_mode "$mode"
          insert_jump "$mode"

          [[ "$mode" == tc ]] && tc_setup
          ;;
      base)
        nft -f "$NFT_BASE"
        ;;
    esac

    echo "Done reloading."
}

# -----------------------------------------------------------
# entrypoint
# -----------------------------------------------------------
case "${1:-}" in
    base)   cmd_base ;;
    td)     cmd_td ;;
    tc)     cmd_tc "${1:-$TC_RATE}" ;;
    status) cmd_status ;;
    reload) cmd_reload ;;
    *)
        cat <<EOF
Usage: fw-censor <command> [options]

Commands:
  base         Normal access point (base nftables)
  td           Drop traffic matching the traffic_drop rules
  tc [rate]    Rate-limit traffic matching the traffic_control rules
               Default rate: 128kbit
               Example: fw-censor tc 64kbit
  status       Show current mode and counters
  reload       Reload the current mode

Modes:
  base    Base firewall only
  td      traffic_drop (drop matching traffic)
  tc      traffic_control (shape matching traffic)
EOF
        exit 1
        ;;
esac
