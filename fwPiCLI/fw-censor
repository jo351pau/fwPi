#!/bin/bash

# /usr/local/bin/fw-censor
# Censorship testbed CLI
#
# Modes:
#   base  - Normal access point
#   td    - Traffic Drop
#   tc    - Traffic Control

set -euo pipefail

LIB_DIR="/usr/local/lib/fwPi/fwPiCLI"

source "$LIB_DIR/config"
source "$LIB_DIR/lib"

# -----------------------------------------------------------
# commands
# -----------------------------------------------------------
cmd_base() {
  teardown_all

  nft -f "$NFT_BASE"

  pihole_disable

  set_mode "base"
  echo "Base access point active"
}

cmd_td() {
  teardown_all

  pihole_enable

  load_mode td
  insert_jump td

  set_mode td
  echo "Traffic Drop mode active"
}

cmd_tc() {
  local rate="${2:-$TC_RATE}"

  teardown_all

  pihole_disable # ummm right ?

  load_mode tc
  insert_jump tc
  tc_setup "$rate"

  set_mode tc
  echo "Traffic Control access point active"
}

cmd_status() {
    local mode
    mode=$(current_mode)

    echo ""
    echo "==============================="
    echo " fw-censor status"
    echo "==============================="
    echo "Mode              : $mode"
    echo "Pi-hole blocklist : $(pihole_status)"
    echo "TC tree           : $(tc_status)"
    echo

    case "$mode" in
        base)
            echo "Normal access point."
            ;;

        td)
            echo "---------------------------"
            echo "--- Traffic Drop chain ---"
            echo
            nft list chain "$TABLE" "$CHAIN_TD"
            ;;

        tc)
            echo "-----------------------------"
            echo "--- Traffic Control chain ---"
            echo
            nft list chain "$TABLE" "$CHAIN_TC"

            echo "-----------------------------"
            echo "--- Traffic Control stats ---"
            echo
            tc -s class show dev "$IFACE"
            ;;
    esac
}

# reload always uses default rate for tc
cmd_reload() {
    local mode
    mode=$(current_mode)

    echo "Reloading $mode configuration..."

    case "$mode" in
      base)
          cmd_base
          ;;
      td)
          cmd_td
          ;;
      tc)
          cmd_tc
          ;;
    esac

    echo "Done."
}

usage() {
cat <<EOF
Usage:
  fw-censor <command> [options]

Commands:
  base
      Normal access point.
      Disables Traffic Drop and Traffic Control.

  td
      Enable Traffic Drop.
      Matching traffic is dropped.

  tc [rate]
      Enable Traffic Control.
      Matching traffic is rate-limited.

      Default rate: $TC_RATE
      Example:
        fw-censor tc 64kbit

  status
      Show the current mode and runtime status.

  reload
      Reload the active configuration.

Modes:
  base    Normal access point
  td      Traffic Drop
  tc      Traffic Control
EOF
}

# -----------------------------------------------------------
# entrypoint
# -----------------------------------------------------------
case "${1:-}" in
    base)   cmd_base ;;
    td)     cmd_td ;;
    tc)     cmd_tc "${2:-$TC_RATE}" ;; # This takes the second arg or default rate
    status) cmd_status ;;
    reload) cmd_reload ;;
    *)      usage exit 1 ;;
esac